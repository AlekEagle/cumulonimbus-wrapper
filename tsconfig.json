{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": true,
    "declarationDir": "./dist/types",
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "rootDir": "./src/",
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types"],
    "alwaysStrict": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"]
}
